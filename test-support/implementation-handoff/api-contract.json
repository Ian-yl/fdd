{
  "schemaVersion": "1.0",
  "operations": [
    {
      "id": "create-submission",
      "capabilityId": "cap-submit",
      "semantics": "Persist the submission configuration atomically and enqueue generation of the requested item count.",
      "method": "POST",
      "path": "/api/submissions",
      "request": {
        "contentType": "application/json",
        "body": [
          "title",
          "category",
          "quantity",
          "resourceIds"
        ],
        "bodySchema": {
          "type": "object",
          "required": [
            "title",
            "category",
            "quantity",
            "resourceIds"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "category": {
              "type": "string",
              "enum": [
                "standard",
                "priority"
              ]
            },
            "quantity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "resourceIds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        }
      },
      "response": {
        "successStatuses": [
          201
        ],
        "bodySchema": {
          "type": "object",
          "required": [
            "submissionId",
            "status",
            "items",
            "quantity"
          ],
          "properties": {
            "submissionId": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "enum": [
                "succeeded",
                "processing",
                "failed"
              ]
            },
            "quantity": {
              "type": "integer",
              "minimum": 1
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "itemId",
                  "mediaUrl"
                ],
                "properties": {
                  "itemId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "mediaUrl": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "authorization": {
        "authentication": "required",
        "permission": "create:submission-configuration",
        "ownership": "current-user"
      },
      "effects": [
        {
          "id": "effect-create-submission",
          "entityId": "submission-configuration",
          "effect": "create"
        },
        {
          "id": "effect-create-result",
          "entityId": "submission-result",
          "effect": "create"
        }
      ],
      "errors": [
        {
          "code": "NOT_AUTHORIZED",
          "status": 403,
          "recovery": "authenticate or select an owned resource"
        },
        {
          "code": "INVALID_INPUT",
          "status": 422,
          "recovery": "correct the identified field"
        },
        {
          "code": "CONFLICT",
          "status": 409,
          "recovery": "refresh authoritative state and retry when allowed"
        }
      ],
      "transaction": {
        "boundary": "submission-configuration",
        "atomic": true
      },
      "consistency": null,
      "idempotency": {
        "required": true,
        "key": "Idempotency-Key"
      },
      "concurrency": {
        "strategy": "optimistic-version"
      },
      "ruleIds": [
        "rule-submission-quantity"
      ],
      "dataDependencies": [
        {
          "sourceOperationId": "upload-resource-op",
          "sourceField": "response.resourceId",
          "targetOperationId": "create-submission",
          "targetField": "request.resourceIds",
          "requiredOwnership": "current-user",
          "requiredLifecycleStatus": "available",
          "consistencyRequirement": "read-your-writes",
          "runtimeValueRequired": true
        }
      ],
      "acceptanceExample": {
        "given": {
          "title": "Spring launch tee",
          "category": "standard",
          "quantity": 2,
          "resourceIds": [
            "res-abc"
          ]
        },
        "when": "invoke create-submission",
        "then": [
          {
            "path": "response.status",
            "equals": "succeeded"
          }
        ]
      },
      "evidence": {
        "status": "designed",
        "sources": [
          "page:submission",
          "page-module:submit-submission"
        ]
      },
      "providerContract": {
        "requiredCapability": "media-generation",
        "parameterMappings": [
          {
            "source": "request.resourceIds",
            "target": "provider.inputs",
            "required": true
          }
        ],
        "outputConstraints": {
          "items": {
            "type": "array",
            "minItems": 1
          }
        },
        "outputMode": "independent-items",
        "oneProviderResultPerItem": true,
        "batchSupportAssumed": false,
        "perCallConstraints": {
          "singleItemPerCall": true,
          "distinctMediaPerCall": true,
          "outputSemantic": "each provider invocation returns exactly one independent media item with its own identifier and media resource"
        },
        "concurrency": {
          "maxParallel": 16,
          "ordering": "unordered",
          "failurePolicy": "fail-fast"
        }
      },
      "integrationBindings": [
        {
          "source": "request.resourceIds",
          "target": "provider.inputs",
          "required": true,
          "schema": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "status": "designed",
            "sources": [
              "page-module:result-items",
              "page:submission"
            ]
          }
        }
      ],
      "integrationVerification": {
        "requiredScenarios": [
          "success",
          "timeout",
          "unavailable"
        ],
        "artifactAssertions": [
          {
            "path": "response.submissionId",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "path": "response.items",
            "schema": {
              "type": "array",
              "minItems": 1
            }
          }
        ],
        "endpointPolicy": {
          "nonLocal": true
        }
      }
    },
    {
      "id": "upload-resource-op",
      "capabilityId": "cap-upload",
      "semantics": "Validate and store an uploaded source file, returning an owned resource reference.",
      "method": "POST",
      "path": "/api/submissions/resources",
      "request": {
        "contentType": "multipart/form-data",
        "body": [
          "files"
        ],
        "bodySchema": {
          "type": "object",
          "required": [
            "files"
          ],
          "properties": {
            "files": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "string",
                "format": "binary"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "response": {
        "successStatuses": [
          201
        ],
        "bodySchema": {
          "type": "object",
          "required": [
            "resourceId",
            "checksum",
            "status"
          ],
          "properties": {
            "resourceId": {
              "type": "string",
              "minLength": 1
            },
            "checksum": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "enum": [
                "available",
                "rejected"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "authorization": {
        "authentication": "required",
        "permission": "create:submission-resource",
        "ownership": "current-user"
      },
      "effects": [
        {
          "id": "effect-upload-resource",
          "entityId": "submission-resource",
          "effect": "create"
        }
      ],
      "errors": [
        {
          "code": "NOT_AUTHORIZED",
          "status": 403,
          "recovery": "authenticate or select an owned resource"
        },
        {
          "code": "INVALID_INPUT",
          "status": 422,
          "recovery": "correct the identified field"
        },
        {
          "code": "CONFLICT",
          "status": 409,
          "recovery": "refresh authoritative state and retry when allowed"
        }
      ],
      "transaction": {
        "boundary": "submission-resource",
        "atomic": true
      },
      "consistency": null,
      "idempotency": {
        "required": true,
        "key": "Idempotency-Key"
      },
      "concurrency": {
        "strategy": "optimistic-version"
      },
      "ruleIds": [
        "rule-resource-checksum"
      ],
      "resourceTransfer": {
        "fileField": "files",
        "responseIdPath": "response.resourceId",
        "interaction": "file-selection",
        "constraints": {
          "maxBytesPerFile": 20971520,
          "checksum": "sha256",
          "multiplicity": "single"
        }
      },
      "acceptanceExample": {
        "given": {
          "files": [
            "challenge.bin"
          ]
        },
        "when": "invoke upload-resource-op",
        "then": [
          {
            "path": "response.status",
            "equals": "available"
          }
        ]
      },
      "evidence": {
        "status": "observed",
        "sources": [
          "page-module:upload-resource",
          "observed-interaction:interaction-upload"
        ]
      }
    },
    {
      "id": "assist-title-op",
      "capabilityId": "cap-assist",
      "semantics": "Generate a title suggestion from the uploaded source via an external text-generation capability.",
      "method": "POST",
      "path": "/api/submissions/assist-title",
      "request": {
        "contentType": "application/json",
        "body": [
          "resourceIds"
        ],
        "bodySchema": {
          "type": "object",
          "required": [
            "resourceIds"
          ],
          "properties": {
            "resourceIds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        }
      },
      "response": {
        "successStatuses": [
          200
        ],
        "bodySchema": {
          "type": "object",
          "required": [
            "operationId",
            "status",
            "suggestion"
          ],
          "properties": {
            "operationId": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "enum": [
                "completed",
                "failed"
              ]
            },
            "suggestion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "additionalProperties": false
        }
      },
      "authorization": {
        "authentication": "required",
        "permission": "invoke:submission-assist",
        "ownership": "current-user"
      },
      "effects": [
        {
          "id": "effect-read-assist-resource",
          "entityId": "submission-resource",
          "effect": "read"
        }
      ],
      "errors": [
        {
          "code": "NOT_AUTHORIZED",
          "status": 403,
          "recovery": "authenticate or select an owned resource"
        },
        {
          "code": "INVALID_INPUT",
          "status": 422,
          "recovery": "correct the identified field"
        },
        {
          "code": "CONFLICT",
          "status": 409,
          "recovery": "refresh authoritative state and retry when allowed"
        }
      ],
      "transaction": null,
      "consistency": {
        "strategy": "read-your-writes"
      },
      "idempotency": {
        "required": false,
        "key": null
      },
      "concurrency": {
        "strategy": "snapshot-read"
      },
      "ruleIds": [
        "rule-assist-provider"
      ],
      "providerContract": {
        "requiredCapability": "text-generation",
        "parameterMappings": [
          {
            "source": "request.resourceIds",
            "target": "provider.inputs",
            "required": true
          }
        ],
        "outputConstraints": {
          "suggestion": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "integrationBindings": [
        {
          "source": "request.resourceIds",
          "target": "provider.inputs",
          "required": true,
          "schema": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "status": "designed",
            "sources": [
              "annotation:assist-title"
            ]
          }
        }
      ],
      "integrationVerification": {
        "requiredScenarios": [
          "success",
          "timeout",
          "unavailable"
        ],
        "artifactAssertions": [
          {
            "path": "response.operationId",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "path": "response.suggestion",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "endpointPolicy": {
          "nonLocal": true
        }
      },
      "dataDependencies": [
        {
          "sourceOperationId": "upload-resource-op",
          "sourceField": "response.resourceId",
          "targetOperationId": "assist-title-op",
          "targetField": "request.resourceIds",
          "requiredOwnership": "current-user",
          "requiredLifecycleStatus": "available",
          "consistencyRequirement": "read-your-writes",
          "runtimeValueRequired": true
        }
      ],
      "acceptanceExample": {
        "given": {
          "resourceIds": [
            "res-abc"
          ]
        },
        "when": "invoke assist-title-op",
        "then": [
          {
            "path": "response.status",
            "equals": "completed"
          }
        ]
      },
      "evidence": {
        "status": "designed",
        "sources": [
          "annotation:assist-title"
        ]
      }
    }
  ]
}
